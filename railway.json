{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd Evi_Contract_Engine && npm install && cd ../webbuilder-main && pip install -r ../requirements.txt"
  },
  "deploy": {
    "startCommand": "cd webbuilder-main && uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
