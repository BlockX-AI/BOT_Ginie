# OpenAI API Key (Preferred - uses GPT-4o for contract generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Gemini AI API Key (Fallback if OpenAI not set)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Database (Optional - for job persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/evi_contracts

# BOT Chain Configuration
# Mainnet: Chain ID 677, RPC: https://rpc.botchain.ai, Explorer: https://scan.botchain.ai
BOT_CHAIN_RPC_URL=https://rpc.botchain.ai
# Testnet (Bohr): Chain ID 968, RPC: https://rpc.bohr.life, Explorer: https://scan.bohr.life
BOT_CHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_PRIVATE_KEY=your_private_key_here_without_0x
BOT_CHAIN_EXPLORER_API=https://scan.botchain.ai/api
BOT_CHAIN_EXPLORER_BROWSER=https://scan.botchain.ai
BOT_CHAIN_TESTNET_EXPLORER_API=https://scan.bohr.life/api
BOT_CHAIN_TESTNET_EXPLORER_BROWSER=https://scan.bohr.life
BOT_CHAIN_EXPLORER_API_KEY=abc

# Server Configuration
PORT=3000
NODE_ENV=development

# Other Networks (Optional)
CAMP_TESTNET_RPC_URL=https://325000.rpc.thirdweb.com
CAMP_PRIVATE_KEY=
BASECAMP_RPC_URL=https://rpc.basecamp.t.raas.gelato.cloud
BASECAMP_PRIVATE_KEY=
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_PRIVATE_KEY=
