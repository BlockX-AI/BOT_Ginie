    {
      "path": "contracts/AI_ai_pipeline_1f9e87ee-2887-4941-acfd-3519eef88287_SafeTreasuryTimelock.sol",
      "content": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/access/AccessControl.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\nimport \"@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol\";\nimport \"@openzeppelin/contracts/token/ERC20/IERC20.sol\";\nimport \"@openzeppelin/contracts/utils/Address.sol\";\n\n/**\n * @title SafeTreasuryTimelock\n * @author Your Name\n * @notice A multi-signature-like treasury with role-based access control and a\n * mandatory timelock for queued ETH and ERC20 token transfers.\n *\n * This contract uses four distinct roles for managing operations:\n * - ADMIN_ROLE: Manages roles and contract parameters like the minimum delay.\n * - PROPOSER_ROLE: Can queue new transfer operations.\n * - EXECUTOR_ROLE: Can execute queued operations after the timelock delay has passed.\n * - CANCELLER_ROLE: Can cancel a queued operation.\n *\n * All transfers must be queued and can only be executed after a configurable `minDelay`.\n * Operations are identified by a unique hash of their parameters. The contract can be\n * paused by an ADMIN, which prevents the execution of operations.\n */\ncontract SafeTreasuryTimelock is AccessControl, Pausable, ReentrancyGuard {\n    using SafeERC20 for IERC20;\n\n    // --- Events ---\n    event OperationQueued(\n        bytes32 indexed id,\n        address indexed proposer,\n        address target,\n        address token,\n        address recipient,\n        uint256 amount,\n        uint256 eta,\n        bytes32 salt\n    );\n    event OperationExecuted(bytes32 indexed id, address indexed executor);\n    event OperationCancelled(bytes32 indexed id, address indexed canceller);\n    event MinDelayChanged(uint256 oldDelay, uint256 newDelay);\n\n    // --- Roles ---\n    bytes32 public constant ADMIN_ROLE = DEFAULT_ADMIN_ROLE;\n    bytes32 public constant PROPOSER_ROLE = keccak256(\"PROPOSER_ROLE\");\n    bytes32 public constant EXECUTOR_ROLE = keccak256(\"EXECUTOR_ROLE\");\n    bytes32 public constant CANCELLER_ROLE = keccak256(\"CANCELLER_ROLE\");\n\n    // --- State ---\n    enum State { Unused, Queued, Executed, Cancelled }\n\n    uint256 public minDelay;\n    uint256 public constant GRACE_PERIOD = 14 days;\n\n    mapping(bytes32 => State) public operations;\n    mapping(bytes32 => uint256) public operationEtas;\n\n    // For listing pending operations\n    bytes32[] private _pendingOperationIds;\n    mapping(bytes32 => uint256) private _pendingOperationIndex;\n\n    // --- Custom Errors ---\n    error InvalidEta(uint256 providedEta, uint256 minEta);\n    error OperationAlreadyExists(bytes32 id);\n    error OperationNotQueued(bytes32 id);\n    error TimestampNotInWindow(uint256 blockTimestamp, uint256 eta);\n    error InvalidTransferParams();\n\n    // --- Constructor ---\n    constructor(\n        address initialAdmin,\n        address[] memory initialProposers,\n        address[] memory initialExecutors,\n        address[] memory initialCancellers,\n        uint256 initialMinDelay\n    ) {\n        _grantRole(ADMIN_ROLE, initialAdmin);\n\n        for (uint256 i = 0; i < initialProposers.length; i++) {\n            _grantRole(PROPOSER_ROLE, initialProposers[i]);\n        }\n        for (uint256 i = 0; i < initialExecutors.length; i++) {\n            _grantRole(EXECUTOR_ROLE, initialExecutors[i]);\n        }\n        for (uint256 i = 0; i < initialCancellers.length; i++) {\n            _grantRole(CANCELLER_ROLE, initialCancellers[i]);\n        }\n        \n        minDelay = initialMinDelay;\n        emit MinDelayChanged(0, initialMinDelay);\n    }\n    \n    // --- Receive ETH ---\n    receive() external payable {}\n\n    // --- Admin and Pausable Functions ---\n    /**\n     * @notice Pauses the contract, preventing operation execution.\n     * @dev Can only be called by an account with the ADMIN_ROLE.\n     */\n    function pause() public onlyRole(ADMIN_ROLE) {\n        _pause();\n    }\n\n    /**\n     * @notice Unpauses the contract, re-enabling operation execution.\n     * @dev Can only be called by an account with the ADMIN_ROLE.\n     */\n    function unpause() public onlyRole(ADMIN_ROLE) {\n        _unpause();\n    }\n\n    /**\n     * @notice Updates the minimum delay for new operations.\n     * @dev Can only be called by an account with the ADMIN_ROLE.\n     * @param newMinDelay The new minimum delay in seconds.\n     */\n    function updateMinDelay(uint256 newMinDelay) public onlyRole(ADMIN_ROLE) {\n        uint256 oldDelay = minDelay;\n        minDelay = newMinDelay;\n        emit MinDelayChanged(oldDelay, newMinDelay);\n    }\n\n    // --- Core Logic ---\n    /**\n     * @notice Queues a transfer operation.\n     * @dev The `eta` must be at least `block.timestamp + minDelay`.\n     * For ETH transfers, `token` and `target` must be the zero address.\n     * For ERC20 transfers, `token` and `target` must be the token's contract address.\n     * @param target For ERC20, the token address. For ETH, the zero address.\n     * @param token The token address, or zero address for ETH.\n     * @param recipient The recipient of the funds.\n     * @param amount The amount of tokens or ETH to transfer.\n     * @param eta The estimated time of arrival (execution time).\n     * @param salt A random value to ensure operation uniqueness.\n     */\n    function queue(\n        address target,\n        address token,\n        address recipient,\n        uint256 amount,\n        uint256 eta,\n        bytes32 salt\n    ) public onlyRole(PROPOSER_ROLE) {\n        uint256 minEta = block.timestamp + minDelay;\n        if (eta < minEta) {\n            revert InvalidEta(eta, minEta);\n        }\n\n        if ((token == address(0) && target != address(0)) || (token != address(0) && target != token)) {\n            revert InvalidTransferParams();\n        }\n\n        bytes32 id = hashOperation(target, token, recipient, amount, eta, salt);\n\n        if (operations[id] != State.Unused) {\n            revert OperationAlreadyExists(id);\n        }\n\n        operations[id] = State.Queued;\n        operationEtas[id] = eta;\n        \n        _addPendingOperation(id);\n\n        emit OperationQueued(id, _msgSender(), target, token, recipient, amount, eta, salt);\n    }\n\n    /**\n     * @notice Executes a queued transfer operation.\n     * @dev Can only be executed after `eta` and before `eta + GRACE_PERIOD`.\n     * The contract must hold the funds to be transferred.\n     * This function is protected against reentrancy and is disabled when paused.\n     */\n    function execute(\n        address target,\n        address token,\n        address recipient,\n        uint256 amount,\n        uint256 eta,\n        bytes32 salt\n    ) public onlyRole(EXECUTOR_ROLE) whenNotPaused nonReentrant {\n        bytes32 id = hashOperation(target, token, recipient, amount, eta, salt);\n\n        if (operations[id] != State.Queued) {\n            revert OperationNotQueued(id);\n        }\n        \n        if (block.timestamp < operationEtas[id] || block.timestamp > operationEtas[id] + GRACE_PERIOD) {\n            revert TimestampNotInWindow(block.timestamp, operationEtas[id]);\n        }\n\n        operations[id] = State.Executed;\n        _removePendingOperation(id);\n\n        _performTransfer(token, recipient, amount);\n\n        emit OperationExecuted(id, _msgSender());\n    }\n\n    /**\n     * @notice Cancels a queued operation.\n     * @param id The unique identifier of the operation to cancel.\n     */\n    function cancel(bytes32 id) public onlyRole(CANCELLER_ROLE) {\n        if (operations[id] != State.Queued) {\n            revert OperationNotQueued(id);\n        }\n        \n        operations[id] = State.Cancelled;\n        _removePendingOperation(id);\n\n        emit OperationCancelled(id, _msgSender());\n    }\n\n    // --- Private Helpers ---\n    function _performTransfer(\n        address token,\n        address recipient,\n        uint256 amount\n    ) private {\n        if (token == address(0)) {\n            Address.sendValue(payable(recipient), amount);\n        } else {\n            IERC20(token).safeTransfer(recipient, amount);\n        }\n    }\n    \n    function _addPendingOperation(bytes32 id) private {\n        _pendingOperationIndex[id] = _pendingOperationIds.length;\n        _pendingOperationIds.push(id);\n    }\n    \n    function _removePendingOperation(bytes32 id) private {\n        uint256 index = _pendingOperationIndex[id];\n        uint256 lastIndex = _pendingOperationIds.length - 1;\n        if (index != lastIndex) {\n            bytes32 lastId = _pendingOperationIds[lastIndex];\n            _pendingOperationIds[index] = lastId;\n            _pendingOperationIndex[lastId] = index;\n        }\n        \n        _pendingOperationIds.pop();\n        delete _pendingOperationIndex[id];\n    }\n\n    // --- Views ---\n    /**\n     * @notice Gets the state and ETA of a specific operation.\n     * @param id The unique identifier of the operation.\n     * @return state The current state of the operation.\n     * @return eta The scheduled execution timestamp of the operation.\n     */\n    function getOperation(bytes32 id) public view returns (State state, uint256 eta) {\n        return (operations[id], operationEtas[id]);\n    }\n    \n    /**\n     * @notice Returns an array of all pending operation IDs.\n     * @dev Useful for UIs to display all operations awaiting execution or cancellation.\n     */\n    function getPendingOperations() public view returns (bytes32[] memory) {\n        return _pendingOperationIds;\n    }\n\n    /**\n     * @notice Computes the unique identifier for an operation.\n     * @dev Pure function that can be called off-chain to predict an operation's ID.\n     */\n    function hashOperation(\n        address target,\n        address token,\n        address recipient,\n        uint256 amount,\n        uint256 eta,\n        bytes32 salt\n    ) public pure returns (bytes32) {\n        return keccak256(abi.encode(target, token, recipient, amount, eta, salt));\n    }\n}\n"
    }
