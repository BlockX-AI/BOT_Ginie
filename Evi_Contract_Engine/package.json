{
  "name": "research-citation-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for academic research paper citation and royalty distribution",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy:basecamp": "hardhat run scripts/deploy.js --network basecamp",
    "deploy:camp-testnet:erc20": "hardhat run scripts/deploy-erc20.js --network camp-testnet",
    "start": "node api/server.js",
    "start:railway": "node api/server.js",
    "start:3001": "PORT=3001 node api/server.js",
    "test:api": "node scripts/test-api.js",
    "retrieve:contract": "node scripts/retrieve-blockscout.js",
    "retrieve:camp-testnet": "NETWORK=camp-testnet node scripts/retrieve-blockscout.js",
    "retrieve:camp-netnet": "NETWORK=camp-netnet node scripts/retrieve-blockscout.js",
    "retrieve:basecamp": "NETWORK=basecamp node scripts/retrieve-blockscout.js",
    "test:retrieval": "NETWORK=camp-testnet node scripts/test-blockscout-retrieval.js",
    "test:retrieval:integrate": "NETWORK=camp-testnet node scripts/test-blockscout-retrieval.js --integrate",
    "test:retrieval:mainnet": "NETWORK=camp-netnet node scripts/test-blockscout-retrieval.js",
    "test:retrieval:basecamp": "NETWORK=basecamp node scripts/test-blockscout-retrieval.js",
    "batch:retrieve": "node scripts/batch-retrieve-contracts.js"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "camp",
    "research",
    "citation",
    "royalty"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@blockxai/camp-codegen": "^2.0.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^4.9.0",
    "blockx-deploy": "^1.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0",
    "express": "^4.19.2",
    "hardhat": "^2.19.0",
    "pg": "^8.11.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vercel": "^44.7.3"
  }
}
