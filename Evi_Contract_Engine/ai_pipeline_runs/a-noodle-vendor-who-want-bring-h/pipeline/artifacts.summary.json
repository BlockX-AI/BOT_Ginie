      "path": "contracts/AI_ai_pipeline_9949a025-d61c-4a7f-8d33-667088564525_Noodle.sol",
      "content": "pragma solidity ^0.8.19;\n\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\n\n/**\n * @title NoodleVendor\n * @author Expert Solidity Engineer\n * @notice A smart contract for an on-chain Noodle Vending Machine.\n * @dev This contract allows an owner to manage a menu of noodle dishes and withdraw\n *      profits. Customers can purchase noodles by sending the exact amount of ETH.\n *      It uses OpenZeppelin contracts for ownership, pausable functionality, and\n *      reentrancy protection.\n */\ncontract NoodleVendor is Ownable, Pausable, ReentrancyGuard {\n    \n    /**\n     * @notice Represents a single noodle dish on the menu.\n     * @param name The name of the noodle dish (e.g., \"Spicy Ramen\").\n     * @param priceInWei The price of the dish in wei.\n     * @param isActive Whether the dish is currently available for purchase.\n     */\n    struct NoodleMenuItem {\n        string name;\n        uint256 priceInWei;\n        bool isActive;\n    }\n\n    /**\n     * @notice Mapping from a unique menu item ID to the NoodleMenuItem struct.\n     */\n    mapping(uint256 => NoodleMenuItem) public menu;\n\n    /**\n     * @notice A counter to generate unique IDs for new menu items.\n     */\n    uint256 public menuItemCounter;\n\n    // --- Events ---\n\n    event MenuItemAdded(uint256 indexed menuId, string name, uint256 priceInWei);\n    event MenuItemPriceUpdated(uint256 indexed menuId, uint256 newPriceInWei);\n    event MenuItemActiveToggled(uint256 indexed menuId, bool isActive);\n    event NoodlePurchased(address indexed customer, uint256 indexed menuId, uint256 pricePaid);\n    event FundsWithdrawn(address indexed owner, uint256 amount);\n\n    /**\n     * @notice The constructor is empty as per requirements.\n     * Ownership is set to the deployer in the Ownable constructor.\n     */\n    constructor() {}\n\n    // --- Customer Functions ---\n\n    /**\n     * @notice Allows a customer to purchase a noodle dish by sending its exact price in ETH.\n     * @dev The contract must not be paused, and the selected menu item must exist and be active.\n     * @param _menuId The ID of the noodle dish to purchase.\n     */\n    function purchaseNoodle(uint256 _menuId) external payable whenNotPaused {\n        require(_menuId < menuItemCounter, \"NoodleVendor: Menu item does not exist.\");\n        \n        NoodleMenuItem storage item = menu[_menuId];\n\n        require(item.isActive, \"NoodleVendor: This noodle dish is currently unavailable.\");\n        require(msg.value == item.priceInWei, \"NoodleVendor: Incorrect payment amount sent.\");\n        \n        emit NoodlePurchased(msg.sender, _menuId, msg.value);\n    }\n\n    // --- Admin Functions ---\n\n    /**\n     * @notice Adds a new noodle dish to the menu.\n     * @dev Can only be called by the contract owner.\n     * @param _name The name of the new noodle dish.\n     * @param _priceInWei The price of the dish in wei.\n     */\n    function addMenuItem(string memory _name, uint256 _priceInWei) external onlyOwner {\n        require(bytes(_name).length > 0, \"NoodleVendor: Noodle name cannot be empty.\");\n        require(_priceInWei > 0, \"NoodleVendor: Price must be greater than zero.\");\n\n        uint256 menuId = menuItemCounter;\n        menu[menuId] = NoodleMenuItem({\n            name: _name,\n            priceInWei: _priceInWei,\n            isActive: true\n        });\n\n        menuItemCounter++;\n\n        emit MenuItemAdded(menuId, _name, _priceInWei);\n    }\n\n    /**\n     * @notice Updates the price of an existing noodle dish.\n     * @dev Can only be called by the contract owner.\n     * @param _menuId The ID of the menu item to update.\n     * @param _newPriceInWei The new price in wei.\n     */\n    function updateMenuItemPrice(uint256 _menuId, uint256 _newPriceInWei) external onlyOwner {\n        require(_menuId < menuItemCounter, \"NoodleVendor: Menu item does not exist.\");\n        require(_newPriceInWei > 0, \"NoodleVendor: Price must be greater than zero.\");\n\n        menu[_menuId].priceInWei = _newPriceInWei;\n        emit MenuItemPriceUpdated(_menuId, _newPriceInWei);\n    }\n\n    /**\n     * @notice Toggles the availability of a noodle dish.\n     * @dev Can only be called by the contract owner.\n     * @param _menuId The ID of the menu item to toggle.\n     */\n    function toggleMenuItemActive(uint256 _menuId) external onlyOwner {\n        require(_menuId < menuItemCounter, \"NoodleVendor: Menu item does not exist.\");\n        \n        NoodleMenuItem storage item = menu[_menuId];\n        item.isActive = !item.isActive;\n\n        emit MenuItemActiveToggled(_menuId, item.isActive);\n    }\n    \n    /**\n     * @notice Pauses the contract, halting all purchases.\n     * @dev Can only be called by the contract owner. Administrative functions remain active.\n     */\n    function pause() external onlyOwner {\n        _pause();\n    }\n\n    /**\n     * @notice Unpauses the contract, resuming all purchases.\n     * @dev Can only be called by the contract owner.\n     */\n    function unpause() external onlyOwner {\n        _unpause();\n    }\n\n    /**\n     * @notice Withdraws the entire ETH balance of the contract to the owner's address.\n     * @dev Uses the nonReentrant modifier and a low-level call to securely transfer funds,\n     *      following the checks-effects-interactions pattern.\n     */\n    function withdraw() external onlyOwner nonReentrant {\n        uint256 amount = address(this).balance;\n        require(amount > 0, \"NoodleVendor: No funds to withdraw.\");\n\n        // Using a low-level call is the recommended way to send Ether since Solidity 0.8.0\n        (bool success, ) = owner().call{value: amount}(\"\");\n        require(success, \"NoodleVendor: Failed to send Ether.\");\n        \n        emit FundsWithdrawn(owner(), amount);\n    }\n}\n"
    }
  ],
