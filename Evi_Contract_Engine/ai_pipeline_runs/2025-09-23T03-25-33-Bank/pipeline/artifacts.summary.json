    {
      "path": "contracts/AI_ai_pipeline_110c9749-0cb2-4e7a-b112-aaa077fcf5f8_PaniPuri.sol",
      "content": "pragma solidity ^0.8.19;\n\nimport \"@openzeppelin/contracts/token/ERC20/ERC20.sol\";\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\n\n/**\n * @title PaniPuri\n * @author An Expert Solidity Engineer\n * @notice A digital \"thela\" (stall) for buying and redeeming Pani Puri tokens.\n *\n * This contract simulates a Pani Puri stall where:\n * - The owner (thelawala) can set the price of a plate of Pani Puri and withdraw earnings.\n * - The stall can be paused (closed) and unpaused (opened).\n * - Customers can buy PANI tokens (representing plates of Pani Puri) with ETH.\n * - PANI tokens are non-transferable between users; they can only be bought from\n *   the stall and \"redeemed\" (burned) to simulate consumption.\n * - The total supply of Pani Puri is fixed.\n */\ncontract PaniPuri is ERC20, Ownable, Pausable, ReentrancyGuard {\n    // --- Constants ---\n\n    /**\n     * @dev Total number of Pani Puri plates available.\n     * With 18 decimals, this is 1,000,000 * 10**18.\n     */\n    uint256 public constant TOTAL_SUPPLY = 1_000_000 * 1e18;\n\n    /**\n     * @dev Maximum number of plates a customer can buy in a single transaction.\n     */\n    uint256 public constant MAX_PLATES_PER_ORDER = 100;\n\n    // --- State Variables ---\n\n    /**\n     * @dev Price of one plate of Pani Puri in wei.\n     */\n    uint256 public pricePerPlate;\n\n    // --- Events ---\n\n    /**\n     * @notice Emitted when a customer successfully buys Pani Puri.\n     * @param buyer The address of the customer.\n     * @param numberOfPlates The number of plates purchased.\n     * @param totalCost The total ETH paid.\n     */\n    event PaniPuriBought(address indexed buyer, uint256 numberOfPlates, uint256 totalCost);\n\n    /**\n     * @notice Emitted when a customer redeems their PANI tokens.\n     * @param redeemer The address of the customer.\n     * @param numberOfPlates The number of plates redeemed (consumed).\n     */\n    event PaniPuriServed(address indexed redeemer, uint256 numberOfPlates);\n\n    /**\n     * @notice Emitted when the owner updates the price per plate.\n     * @param newPrice The new price in wei.\n     */\n    event PriceUpdated(uint256 newPrice);\n\n    // --- Constructor ---\n\n    /**\n     * @notice Initializes the contract.\n     * The constructor is parameterless as required. It mints the total supply\n     * of PANI tokens to the stall (this contract) and sets an initial price.\n     */\n    constructor() ERC20(\"\", \"\") {\n        // Mint the total supply of PANI tokens to this contract (the stall).\n        _mint(address(this), TOTAL_SUPPLY);\n\n        // Set an initial price of 0.001 ETH per plate.\n        pricePerPlate = 0.001 ether;\n    }\n\n    // --- ERC20 Overrides ---\n\n    /**\n     * @dev Returns the name of the token. Overridden to return a constant\n     * value, which is more gas-efficient than storing it in a state variable.\n     */\n    function name() public pure override returns (string memory) {\n        return \"Pani Puri Plate\";\n    }\n\n    /**\n     * @dev Returns the symbol of the token. Overridden to return a constant\n     * value for gas efficiency.\n     */\n    function symbol() public pure override returns (string memory) {\n        return \"PANI\";\n    }\n\n    /**\n     * @dev Hook that is called before any transfer of tokens.\n     * This implementation restricts token transfers to ensure PANI tokens are\n     * non-transferable between users (soul-bound). They can only be:\n     * 1. Minted (from address(0)).\n     * 2. Sold by the stall (from this contract's address).\n     * 3. Burned by a user for redemption (to address(0)).\n     */\n    function _beforeTokenTransfer(address from, address to, uint256 amount)\n        internal\n        override\n    {\n        super._beforeTokenTransfer(from, to, amount);\n\n        if (from == address(0) || to == address(0) || from == address(this)) {\n            return;\n        }\n\n        revert(\"PaniPuri: PANI tokens are soul-bound and cannot be transferred.\");\n    }\n\n    // --- Customer Functions ---\n\n    /**\n     * @notice Allows a customer to buy Pani Puri plates by sending ETH.\n     * @param _numberOfPlates The number of plates to purchase.\n     */\n    function buyPaniPuri(uint256 _numberOfPlates) public payable whenNotPaused nonReentrant {\n        uint256 currentPrice = pricePerPlate;\n        require(currentPrice > 0, \"PaniPuri: Pricing not set.\");\n        require(_numberOfPlates > 0, \"PaniPuri: Must buy at least one plate.\");\n        require(_numberOfPlates <= MAX_PLATES_PER_ORDER, \"PaniPuri: Order exceeds max plates.\");\n\n        uint256 totalCost = _numberOfPlates * currentPrice;\n        require(msg.value >= totalCost, \"PaniPuri: Insufficient ETH sent.\");\n\n        uint256 amountToTransfer = _numberOfPlates * (10**decimals());\n        require(balanceOf(address(this)) >= amountToTransfer, \"PaniPuri: Stall is out of stock.\");\n\n        // Effects\n        _transfer(address(this), msg.sender, amountToTransfer);\n\n        // Interaction (refund)\n        uint256 refundAmount = msg.value - totalCost;\n        if (refundAmount > 0) {\n            (bool success, ) = msg.sender.call{value: refundAmount}(\"\");\n            require(success, \"PaniPuri: Refund failed.\");\n        }\n\n        emit PaniPuriBought(msg.sender, _numberOfPlates, totalCost);\n    }\n\n    /**\n     * @notice Allows a customer to redeem (consume) their PANI tokens.\n     * This action burns the tokens.\n     * @param _numberOfPlates The number of plates to redeem.\n     */\n    function redeemPaniPuri(uint256 _numberOfPlates) public whenNotPaused {\n        require(_numberOfPlates > 0, \"PaniPuri: Must redeem at least one plate.\");\n\n        // _burn checks for sufficient balance and reverts if needed.\n        _burn(msg.sender, _numberOfPlates * (10**decimals()));\n\n        emit PaniPuriServed(msg.sender, _numberOfPlates);\n    }\n\n    // --- Owner-only Functions ---\n\n    /**\n     * @notice Sets the price for one plate of Pani Puri.\n     * @param _newPrice The new price in wei.\n     */\n    function setPrice(uint256 _newPrice) public onlyOwner {\n        require(_newPrice > 0, \"PaniPuri: Price must be greater than zero.\");\n        pricePerPlate = _newPrice;\n        emit PriceUpdated(_newPrice);\n    }\n\n    /**\n     * @notice Pauses the stall, preventing new purchases or redemptions.\n     * Can only be called by the owner.\n     */\n    function pause() public onlyOwner {\n        _pause();\n    }\n\n    /**\n     * @notice Unpauses the stall, allowing new purchases and redemptions.\n     * Can only be called by the owner.\n     */\n    function unpause() public onlyOwner {\n        _unpause();\n    }\n\n    /**\n     * @notice Withdraws the accumulated ETH balance from the contract to the owner.\n     */\n    function withdrawFunds() public onlyOwner nonReentrant {\n        uint256 balance = address(this).balance;\n        require(balance > 0, \"PaniPuri: No funds to withdraw.\");\n        (bool success, ) = owner().call{value: balance}(\"\");\n        require(success, \"PaniPuri: Failed to withdraw funds.\");\n    }\n\n    // --- View Functions ---\n\n    /**\n     * @notice Returns the number of plates available for sale in the stall.\n     * This is the contract's PANI token balance, adjusted for decimals.\n     */\n    function platesInStock() public view returns (uint256) {\n        return balanceOf(address(this)) / (10**decimals());\n    }\n\n    /**\n     * @notice Returns the number of plates a user holds.\n     * This is the user's PANI token balance, adjusted for decimals.\n     */\n    function platesOf(address account) public view returns (uint256) {\n        return balanceOf(account) / (10**decimals());\n    }\n}\n"
    }
