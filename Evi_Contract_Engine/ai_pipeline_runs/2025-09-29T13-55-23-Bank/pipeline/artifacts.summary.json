      "path": "contracts/AI_ai_pipeline_61944ad3-ada2-400c-8b89-b13c521c233a_Bus.sol",
      "content": "pragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\n\n/**\n * @title Bus\n * @dev A simple contract to manage a bus service.\n * The contract owner (the bus company) can set the ticket price and bus capacity.\n * Users can buy tickets and board the bus when it is at the station.\n * The owner can manage the bus's journey (depart/arrive) and pause the service.\n * All funds are held in the contract until withdrawn by the owner.\n */\ncontract Bus is Ownable, Pausable, ReentrancyGuard {\n\n    /**\n     * @dev Represents the operational status of the bus.\n     * - AtStation: The bus is stationary, ready for boarding.\n     * - InTransit: The bus is on its journey.\n     * - OutOfService: The bus is not operational.\n     */\n    enum Status {\n        AtStation,\n        InTransit,\n        OutOfService\n    }\n\n    uint256 public ticketPrice;\n    uint256 public capacity;\n    uint256 public boardedPassengersCount;\n    Status public busStatus;\n\n    mapping(address => uint256) public tickets;\n\n    event TicketPurchased(address indexed passenger, uint256 quantity, uint256 totalCost);\n    event PassengerBoarded(address indexed passenger);\n    event BusDeparted(uint256 indexed timestamp);\n    event BusArrived(uint256 indexed timestamp);\n    event BusStatusChanged(Status newStatus);\n    event TicketPriceChanged(uint256 newPrice);\n    event CapacityChanged(uint256 newCapacity);\n\n    /**\n     * @dev The constructor is intentionally left empty.\n     * The bus starts at the station by default.\n     * The owner must configure the ticket price and capacity via setters before the service is operational.\n     */\n    constructor() {\n        busStatus = Status.AtStation;\n    }\n\n    /**\n     * @dev Allows the owner to set the price for a single ticket.\n     * @param _newPrice The new price of a ticket in wei.\n     */\n    function setTicketPrice(uint256 _newPrice) external onlyOwner {\n        require(_newPrice > 0, \"Bus: Price must be greater than zero\");\n        ticketPrice = _newPrice;\n        emit TicketPriceChanged(_newPrice);\n    }\n\n    /**\n     * @dev Allows the owner to set the maximum capacity of the bus.\n     * @param _newCapacity The new maximum passenger capacity.\n     */\n    function setCapacity(uint256 _newCapacity) external onlyOwner {\n        require(_newCapacity > 0, \"Bus: Capacity must be greater than zero\");\n        require(_newCapacity >= boardedPassengersCount, \"Bus: Capacity cannot be less than current passengers\");\n        capacity = _newCapacity;\n        emit CapacityChanged(_newCapacity);\n    }\n\n    /**\n     * @dev Allows the owner to change the bus status for administrative purposes.\n     * To complete a journey, the `arrive()` function should be used instead.\n     * @param _newStatus The new status for the bus.\n     */\n    function setBusStatus(Status _newStatus) external onlyOwner {\n        if (_newStatus == Status.AtStation && busStatus == Status.InTransit) {\n            revert(\"Bus: Use arrive() to complete a journey\");\n        }\n        busStatus = _newStatus;\n        emit BusStatusChanged(_newStatus);\n    }\n\n    /**\n     * @dev Allows the owner (acting as the driver) to depart from the station.\n     */\n    function depart() external onlyOwner whenNotPaused isAtStation {\n        busStatus = Status.InTransit;\n        emit BusDeparted(block.timestamp);\n    }\n\n    /**\n     * @dev Allows the owner (acting as the driver) to arrive at the destination.\n     * This resets the boarded passenger count for the next journey. Purchased tickets remain valid.\n     */\n    function arrive() external onlyOwner whenNotPaused isInTransit {\n        busStatus = Status.AtStation;\n        boardedPassengersCount = 0; // Passengers disembark, seats are free for the next trip\n        emit BusArrived(block.timestamp);\n    }\n    \n    /**\n     * @dev Allows the contract owner to withdraw the entire contract balance.\n     */\n    function withdrawFunds() external onlyOwner {\n        uint256 balance = address(this).balance;\n        require(balance > 0, \"Bus: No funds to withdraw\");\n        (bool success, ) = owner().call{value: balance}(\"\");\n        require(success, \"Bus: Withdrawal failed\");\n    }\n\n    /**\n     * @dev Allows a user to purchase one or more tickets.\n     * @param _quantity The number of tickets to purchase.\n     */\n    function buyTickets(uint256 _quantity) external payable whenNotPaused nonReentrant {\n        require(busStatus != Status.OutOfService, \"Bus: Currently out of service\");\n        require(ticketPrice > 0, \"Bus: Ticket price not set\");\n        require(_quantity > 0, \"Bus: Must buy at least one ticket\");\n\n        uint256 totalCost = ticketPrice * _quantity;\n        require(msg.value == totalCost, \"Bus: Incorrect payment amount\");\n\n        tickets[_msgSender()] += _quantity;\n        emit TicketPurchased(_msgSender(), _quantity, totalCost);\n    }\n\n    /**\n     * @dev Allows a user with a valid ticket to board the bus.\n     * This action consumes one ticket.\n     */\n    function boardBus() external whenNotPaused nonReentrant isAtStation {\n        require(capacity > 0, \"Bus: Capacity not set\");\n        require(tickets[_msgSender()] > 0, \"Bus: You do not have a ticket\");\n        require(boardedPassengersCount < capacity, \"Bus: Bus is full\");\n\n        tickets[_msgSender()]--;\n        boardedPassengersCount++;\n        emit PassengerBoarded(_msgSender());\n    }\n\n    /**\n     * @dev Pauses the service. Key functions like buying tickets and boarding will be disabled.\n     * Can only be called by the owner. See {Pausable-_pause}.\n     */\n    function pause() external onlyOwner {\n        _pause();\n    }\n\n    /**\n     * @dev Unpauses the service, resuming normal operations.\n     * Can only be called by the owner. See {Pausable-_unpause}.\n     */\n    function unpause() external onlyOwner {\n        _unpause();\n    }\n    \n    /**\n     * @dev Gets the number of tickets for a specific address.\n     * @param _passenger The address of the passenger.\n     * @return The number of tickets held by the passenger.\n     */\n    function getTicketCount(address _passenger) external view returns (uint256) {\n        return tickets[_passenger];\n    }\n\n    /**\n     * @dev Modifier to ensure the bus is at the station.\n     */\n    modifier isAtStation() {\n        require(busStatus == Status.AtStation, \"Bus: Not at station\");\n        _;\n    }\n\n    /**\n     * @dev Modifier to ensure the bus is in transit.\n     */\n    modifier isInTransit() {\n        require(busStatus == Status.InTransit, \"Bus: Not in transit\");\n        _;\n    }\n}\n"
    }
  ],
