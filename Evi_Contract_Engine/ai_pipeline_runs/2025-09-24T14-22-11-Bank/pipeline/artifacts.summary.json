      "path": "contracts/AI_ai_pipeline_12198ea3-8ac5-4dc6-877a-38f02179e490_Bus.sol",
      "content": "pragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\n\n/**\n * @title Bus\n * @dev A smart contract representing a public bus service.\n * It allows passengers to board by paying a fare, tracks passenger count,\n * and allows the owner to manage the service's parameters and withdraw funds.\n *\n * This contract uses OpenZeppelin's Ownable for access control, Pausable\n * for emergency stops, and ReentrancyGuard to prevent reentrancy attacks\n * on functions involving Ether transfers.\n */\ncontract Bus is Ownable, Pausable, ReentrancyGuard {\n    // ======== State Variables ========\n\n    string public route;\n    uint256 public capacity;\n    uint256 public fare;\n    uint256 public passengerCount;\n\n    mapping(address => bool) private _isPassenger;\n\n    // ======== Events ========\n\n    /**\n     * @dev Emitted when a passenger successfully boards the bus.\n     * @param passenger The address of the passenger.\n     * @param farePaid The amount of ETH paid as fare.\n     */\n    event PassengerBoarded(address indexed passenger, uint256 farePaid);\n\n    /**\n     * @dev Emitted when a passenger alights from the bus.\n     * @param passenger The address of the passenger.\n     */\n    event PassengerAlighted(address indexed passenger);\n\n    /**\n     * @dev Emitted when the bus fare is updated by the owner.\n     * @param newFare The new fare amount.\n     */\n    event FareUpdated(uint256 newFare);\n\n    /**\n     * @dev Emitted when the bus route is updated by the owner.\n     * @param newRoute The new route description.\n     */\n    event RouteUpdated(string newRoute);\n\n    /**\n     * @dev Emitted when the bus capacity is updated by the owner.\n     * @param newCapacity The new maximum capacity.\n     */\n    event CapacityUpdated(uint256 newCapacity);\n\n    // ======== Constructor ========\n\n    /**\n     * @dev Initializes the contract with default values.\n     * The owner can change these values later using the provided setter functions.\n     * The constructor is intentionally parameterless to meet deployment requirements.\n     */\n    constructor() {\n        route = \"City Center Loop\";\n        capacity = 50;\n        fare = 0.001 ether; // 0.001 ETH\n    }\n\n    // ======== View Functions ========\n\n    /**\n     * @dev Checks if a given address is currently a passenger on the bus.\n     * @param account The address to check.\n     * @return bool True if the address is a passenger, false otherwise.\n     */\n    function isPassenger(address account) public view returns (bool) {\n        return _isPassenger[account];\n    }\n\n    // ======== Public Functions ========\n\n    /**\n     * @dev Allows a user to board the bus by paying the required fare.\n     * The contract must not be paused, the bus must not be full, the user\n     * cannot already be a passenger, and the sent value must match the fare exactly.\n     */\n    function board() external payable whenNotPaused nonReentrant {\n        require(passengerCount < capacity, \"Bus: Bus is full\");\n        require(!_isPassenger[msg.sender], \"Bus: Already on board\");\n        require(msg.value == fare, \"Bus: Incorrect fare paid\");\n\n        _isPassenger[msg.sender] = true;\n        passengerCount++;\n\n        emit PassengerBoarded(msg.sender, msg.value);\n    }\n\n    /**\n     * @dev Allows a passenger to alight from the bus.\n     * The contract must not be paused and the caller must be a passenger.\n     */\n    function alight() external whenNotPaused {\n        require(_isPassenger[msg.sender], \"Bus: Not a passenger\");\n\n        _isPassenger[msg.sender] = false;\n        passengerCount--;\n\n        emit PassengerAlighted(msg.sender);\n    }\n\n    // ======== Owner-Only Functions ========\n\n    /**\n     * @dev Updates the bus route. Only the owner can call this.\n     * @param newRoute The new route description string.\n     */\n    function setRoute(string calldata newRoute) external onlyOwner {\n        route = newRoute;\n        emit RouteUpdated(newRoute);\n    }\n\n    /**\n     * @dev Updates the bus capacity. Only the owner can call this.\n     * The new capacity cannot be less than the current number of passengers.\n     * @param newCapacity The new maximum capacity.\n     */\n    function setCapacity(uint256 newCapacity) external onlyOwner {\n        require(newCapacity >= passengerCount, \"Bus: Capacity cannot be less than current passengers\");\n        capacity = newCapacity;\n        emit CapacityUpdated(newCapacity);\n    }\n\n    /**\n     * @dev Updates the bus fare. Only the owner can call this.\n     * @param newFare The new fare in wei.\n     */\n    function setFare(uint256 newFare) external onlyOwner {\n        fare = newFare;\n        emit FareUpdated(newFare);\n    }\n\n    /**\n     * @dev Pauses the service, preventing new passengers from boarding or alighting.\n     * Only the owner can call this.\n     */\n    function pause() external onlyOwner {\n        _pause();\n    }\n\n    /**\n     * @dev Unpauses the service, resuming normal operations.\n     * Only the owner can call this.\n     */\n    function unpause() external onlyOwner {\n        _unpause();\n    }\n\n    /**\n     * @dev Withdraws the entire contract balance to the owner's address.\n     * Only the owner can call this.\n     */\n    function withdraw() external onlyOwner nonReentrant {\n        uint256 balance = address(this).balance;\n        require(balance > 0, \"Bus: No funds to withdraw\");\n        (bool success, ) = owner().call{value: balance}(\"\");\n        require(success, \"Bus: Withdrawal failed\");\n    }\n}\n"
    }
