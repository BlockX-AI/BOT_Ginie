      "path": "contracts/AI_ai_pipeline_cbd0e698-dbbb-4d88-b329-386f95140552_PaniPuri.sol",
      "content": "pragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/token/ERC721/ERC721.sol\";\nimport \"@openzeppelin/contracts/token/ERC721/extensions/ERC721Enumerable.sol\";\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/Pausable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\nimport \"@openzeppelin/contracts/utils/Counters.sol\";\n\n/**\n * @title PaniPuri\n * @dev A digital representation of a Pani Puri stall (thela).\n * This contract allows users to purchase \"Pani Puri Plate\" NFTs.\n * The owner of the stall can set the price, pause sales, and withdraw earnings.\n * It's an ERC721 token, where each token represents a unique plate of Pani Puri.\n */\ncontract PaniPuri is ERC721, ERC721Enumerable, Ownable, Pausable, ReentrancyGuard {\n    using Counters for Counters.Counter;\n\n    // Counter for token IDs. Starts at 1.\n    Counters.Counter private _tokenIdCounter;\n\n    /// @notice The maximum number of Pani Puri plates that can ever be minted.\n    uint256 public constant MAX_SUPPLY = 1000;\n\n    /// @notice The price in wei for a single Pani Puri plate.\n    uint256 public platePrice = 0.01 ether;\n\n    // Base URI for token metadata.\n    string private _baseTokenURI;\n\n    /**\n     * @dev Initializes the contract, setting the name and symbol for the NFT.\n     * The constructor is parameterless as required, and token IDs start from 1.\n     */\n    constructor() ERC721(\"Pani Puri Plate\", \"PURI\") {\n        // Start token IDs from 1 instead of 0\n        _tokenIdCounter.increment();\n    }\n\n    /**\n     * @dev Base URI for computing {tokenURI}. If set, the resulting URI for each\n     * token will be the concatenation of the `_baseURI` and the `tokenId`.\n     */\n    function _baseURI() internal view override returns (string memory) {\n        return _baseTokenURI;\n    }\n\n    /**\n     * @notice Mints one or more new Pani Puri Plate NFTs to the sender.\n     * @param quantity The number of NFTs to purchase.\n     */\n    function purchase(uint256 quantity) public payable whenNotPaused nonReentrant {\n        uint256 currentId = _tokenIdCounter.current();\n        require(quantity > 0, \"PaniPuri: Quantity must be greater than zero\");\n        require(currentId + quantity - 1 <= MAX_SUPPLY, \"PaniPuri: Not enough plates left to fulfill order\");\n        require(msg.value >= platePrice * quantity, \"PaniPuri: Not enough ETH sent for the puris\");\n\n        for (uint256 i = 0; i < quantity; i++) {\n            _safeMint(msg.sender, currentId + i);\n        }\n        for (uint256 i = 0; i < quantity; i++) {\n            _tokenIdCounter.increment();\n        }\n    }\n\n    /**\n     * @notice Pauses all token transfers, including new purchases.\n     * @dev Can only be called by the contract owner.\n     */\n    function pause() public onlyOwner {\n        _pause();\n    }\n\n    /**\n     * @notice Unpauses all token transfers.\n     * @dev Can only be called by the contract owner.\n     */\n    function unpause() public onlyOwner {\n        _unpause();\n    }\n\n    /**\n     * @notice Sets the price for a single Pani Puri Plate NFT.\n     * @param newPrice The new price in wei.\n     */\n    function setPrice(uint256 newPrice) public onlyOwner {\n        platePrice = newPrice;\n    }\n\n    /**\n     * @notice Sets the base URI for token metadata.\n     * @dev Example: \"ipfs://YourCID/\"\n     * @param newBaseURI The new base URI string.\n     */\n    function setBaseURI(string memory newBaseURI) public onlyOwner {\n        _baseTokenURI = newBaseURI;\n    }\n\n    /**\n     * @notice Withdraws the entire contract balance to the owner's address.\n     */\n    function withdraw() public onlyOwner nonReentrant {\n        (bool success, ) = owner().call{value: address(this).balance}(\"\");\n        require(success, \"PaniPuri: Withdrawal failed\");\n    }\n\n    /**\n     * @dev See {ERC721-_beforeTokenTransfer}.\n     *\n     * Overridden to apply the pausable mechanism to all token transfers.\n     * This hook is called before any token transfer, including mints and burns.\n     */\n    function _beforeTokenTransfer(\n        address from,\n        address to,\n        uint256 firstTokenId,\n        uint256 batchSize\n    ) internal override(ERC721, ERC721Enumerable) {\n        super._beforeTokenTransfer(from, to, firstTokenId, batchSize);\n        _requireNotPaused();\n    }\n\n    /**\n     * @dev See {IERC165-supportsInterface}.\n     */\n    function supportsInterface(bytes4 interfaceId)\n        public\n        view\n        override(ERC721, ERC721Enumerable)\n        returns (bool)\n    {\n        return super.supportsInterface(interfaceId);\n    }\n}\n"
    }
  ],
