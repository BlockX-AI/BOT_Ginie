      "path": "contracts/AI_ai_pipeline_0019ac02-f934-4a20-a0b0-867ff842375a_TempleRunner.sol",
      "content": "/**\n * This smart contract is generated by Camp-Codegen\n * Build by www.blockxint.com\n * Feel free to reach out at mohit@blockxint.com for queries\n */\npragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/token/ERC20/ERC20.sol\";\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\nimport \"@openzeppelin/contracts/utils/cryptography/ECDSA.sol\";\n\n/**\n * @title TempleRunner\n * @dev Endless runner game contract with energy system, rewards, and leaderboards.\n *      Uses off-chain physics verification via signature to ensure minimal gas.\n */\ncontract TempleRunner is ERC20, Ownable, ReentrancyGuard {\n    using ECDSA for bytes32;\n\n    // ═══════════════════════════════════════════════════════════════\n    // CONSTANTS & CONFIG\n    // ═══════════════════════════════════════════════════════════════\n    \n    uint256 public constant MAX_ENERGY = 100;\n    uint256 public constant ENERGY_COST = 20;\n    uint256 public constant REGEN_RATE = 5 minutes; // 1 Energy unit per 5 minutes\n    uint256 public constant INITIAL_MINT = 1_000_000;\n\n    // ═══════════════════════════════════════════════════════════════\n    // STATE\n    // ═══════════════════════════════════════════════════════════════\n\n    address public gameSigner;\n    \n    struct GameSession {\n        uint256 id;\n        uint256 startTime;\n        bool active;\n    }\n\n    struct PlayerStats {\n        uint128 energy;\n        uint128 lastEnergyUpdate;\n        uint256 highestScore;\n        uint256 totalDistance;\n        uint256 gamesPlayed;\n    }\n\n    mapping(address => PlayerStats) public stats;\n    mapping(address => GameSession) public sessions;\n    mapping(address => uint256) public nonces;\n    \n    // Leaderboard State\n    uint256 public allTimeHighScore;\n    address public topRunner;\n\n    // ═══════════════════════════════════════════════════════════════\n    // EVENTS\n    // ═══════════════════════════════════════════════════════════════\n\n    event GameStarted(address indexed player, uint256 indexed gameId, uint256 nonce);\n    event GameEnded(address indexed player, uint256 indexed gameId, uint256 score, uint256 coins);\n    event HighScoreBroken(address indexed player, uint256 score);\n    event GlobalRecordBroken(address indexed player, uint256 score);\n    event SignerUpdated(address newSigner);\n\n    // ═══════════════════════════════════════════════════════════════\n    // CONSTRUCTOR\n    // ═══════════════════════════════════════════════════════════════\n\n    constructor() ERC20(\"TempleCoin\", \"RUN\") Ownable() {\n        gameSigner = msg.sender;\n        _mint(msg.sender, INITIAL_MINT * 10 ** decimals());\n    }\n\n    // ═══════════════════════════════════════════════════════════════\n    // ENERGY SYSTEM\n    // ═══════════════════════════════════════════════════════════════\n\n    /**\n     * @notice Calculate current energy based on time passed\n     * @dev Implements lazy regeneration\n     */\n    function getEnergy(address player) public view returns (uint256) {\n        PlayerStats memory p = stats[player];\n        \n        // New players start with full energy\n        if (p.lastEnergyUpdate == 0) return MAX_ENERGY;\n        \n        uint256 timePassed = block.timestamp - p.lastEnergyUpdate;\n        uint256 regenerated = timePassed / REGEN_RATE;\n        uint256 newEnergy = p.energy + regenerated;\n        \n        return newEnergy > MAX_ENERGY ? MAX_ENERGY : newEnergy;\n    }\n\n    /**\n     * @dev Internal spend with lazy update\n     */\n    function _spendEnergy(address player) internal {\n        uint256 current = getEnergy(player);\n        require(current >= ENERGY_COST, \"Insufficient energy\");\n        \n        stats[player].energy = uint128(current - ENERGY_COST);\n        stats[player].lastEnergyUpdate = uint128(block.timestamp);\n    }\n\n    // ═══════════════════════════════════════════════════════════════\n    // GAMEPLAY\n    // ═══════════════════════════════════════════════════════════════\n\n    /**\n     * @notice Start a new run. Consumes energy and creates a session.\n     */\n    function startGame() external nonReentrant {\n        require(!sessions[msg.sender].active, \"Game already in progress\");\n        \n        _spendEnergy(msg.sender);\n        \n        uint256 nonce = nonces[msg.sender]++;\n        // Unique Game ID: chainid + user + nonce prevents replays\n        uint256 gameId = uint256(keccak256(abi.encodePacked(block.chainid, msg.sender, nonce)));\n        \n        sessions[msg.sender] = GameSession({\n            id: gameId,\n            startTime: block.timestamp,\n            active: true\n        });\n        \n        stats[msg.sender].gamesPlayed++;\n        \n        emit GameStarted(msg.sender, gameId, nonce);\n    }\n\n    /**\n     * @notice Submit run results verified by game server\n     * @param score Distance run (meters or points)\n     * @param coins Coins collected\n     * @param signature Server signature of (gameId, score, coins, player, contract)\n     */\n    function submitRun(\n        uint256 score,\n        uint256 coins,\n        bytes calldata signature\n    ) external nonReentrant {\n        GameSession memory session = sessions[msg.sender];\n        require(session.active, \"No active game\");\n        \n        // 1. Verify Signature\n        // Hash includes gameId to prevent replaying old good scores\n        // Includes address(this) to prevent cross-contract replay\n        bytes32 hash = keccak256(abi.encodePacked(\n            session.id,\n            score,\n            coins,\n            msg.sender,\n            address(this)\n        ));\n        \n        address signer = hash.toEthSignedMessageHash().recover(signature);\n        require(signer == gameSigner, \"Invalid score signature\");\n        \n        // 2. Clear Session\n        delete sessions[msg.sender];\n        \n        // 3. Update Stats\n        PlayerStats storage p = stats[msg.sender];\n        p.totalDistance += score;\n        \n        // Local High Score\n        if (score > p.highestScore) {\n            p.highestScore = score;\n            emit HighScoreBroken(msg.sender, score);\n            \n            // Global High Score\n            if (score > allTimeHighScore) {\n                allTimeHighScore = score;\n                topRunner = msg.sender;\n                emit GlobalRecordBroken(msg.sender, score);\n            }\n        }\n        \n        // 4. Mint Rewards\n        if (coins > 0) {\n            _mint(msg.sender, coins * 10 ** decimals());\n        }\n        \n        emit GameEnded(msg.sender, session.id, score, coins);\n    }\n\n    /**\n     * @notice Emergency forfeit if stuck, no rewards\n     */\n    function quitGame() external nonReentrant {\n        require(sessions[msg.sender].active, \"No active game\");\n        delete sessions[msg.sender];\n        emit GameEnded(msg.sender, 0, 0, 0);\n    }\n\n    // ═══════════════════════════════════════════════════════════════\n    // ADMIN\n    // ═══════════════════════════════════════════════════════════════\n\n    function setGameSigner(address _signer) external onlyOwner {\n        require(_signer != address(0), \"Invalid signer\");\n        gameSigner = _signer;\n        emit SignerUpdated(_signer);\n    }\n}\n"
    }
