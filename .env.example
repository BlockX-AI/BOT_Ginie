# =============================================================================
# BOT_Ginie Environment Variables Template
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# WebBuilder Backend (Python/FastAPI)
# =============================================================================

# Database (PostgreSQL on Railway)
DATABASE_URL=postgresql://user:password@host:port/dbname

# E2B Sandbox API (for React app building)
E2B_API_KEY=your_e2b_api_key_here

# LLM API Keys (at least one required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# JWT Secret for auth
SECRET_KEY=your_random_secret_key_here_min_32_chars

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# =============================================================================
# EVI Contract Engine (Node.js/Express)
# =============================================================================

# EVI API Port (Railway will override with $PORT)
PORT=3000

# Blockchain RPC URLs
BOT_CHAIN_RPC=https://rpc.botchain.ai
BOT_CHAIN_TESTNET_RPC=https://rpc.bohr.life

# Private key for contract deployment (DO NOT COMMIT)
PRIVATE_KEY=your_deployer_private_key_here

# Block Explorer API Keys
BOTCHAIN_API_KEY=your_botchain_explorer_api_key_here

# OpenAI for AI contract generation
OPENAI_API_KEY=your_openai_api_key_here

# Sentry (optional, for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# Vercel Deployment (for frontend hosting)
# =============================================================================
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id_here

# =============================================================================
# Optional: Logging & Monitoring
# =============================================================================
LOG_LEVEL=info
NODE_ENV=production
