# =============================================================================
# Ginie Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# The base URL for the Ginie backend API (Railway deployment)
NEXT_PUBLIC_API_BASE_URL=https://web-production-fe77c.up.railway.app

# The webbuilder API URL (same as above for now)
NEXT_PUBLIC_WEBBUILDER_API_URL=https://web-production-fe77c.up.railway.app

# WebSocket URL (optional - defaults to API_BASE_URL if not set)
# NEXT_PUBLIC_WS_URL=wss://web-production-fe77c.up.railway.app

# Alternative API URL (optional fallback)
# NEXT_PUBLIC_API_URL=https://web-production-fe77c.up.railway.app

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# The public URL where your Ginie frontend is deployed
# For local development: http://localhost:3100
# For production: https://ginie-seven.vercel.app
NEXT_PUBLIC_SITE_URL=https://ginie-seven.vercel.app

# Base URL for the app (used in Web3 config)
NEXT_PUBLIC_BASE_URL=https://ginie-seven.vercel.app

# -----------------------------------------------------------------------------
# Web3 / WalletConnect Configuration
# -----------------------------------------------------------------------------
# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=9979a4e84b56845b6b74af340f96769a

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Set to '1' to disable backend API calls (for testing frontend only)
# NEXT_PUBLIC_BACKEND_DISABLED=0

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# Node environment (automatically set by Next.js)
# NODE_ENV=production
