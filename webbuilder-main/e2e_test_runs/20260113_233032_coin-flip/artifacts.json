      "content": "/**\n * This smart contract is generated by Camp-Codegen\n * Build by www.blockxint.com\n * Feel free to reach out at mohit@blockxint.com for queries\n */\npragma solidity ^0.8.20;\n\nimport \"@openzeppelin/contracts/access/Ownable.sol\";\nimport \"@openzeppelin/contracts/security/ReentrancyGuard.sol\";\n\n/**\n * @title CoinFlipBet\n * @notice A production-ready coin flip game using commit-reveal pattern.\n * @dev Implements 2% house edge, solvent payout checks, and anti-cheat commitment scheme.\n *      Requires players to commit to a choice (Heads/Tails) salted with a secret, \n *      then reveal it in a subsequent block to settle the bet using blockhash entropy.\n */\ncontract CoinFlipBet is Ownable, ReentrancyGuard {\n    // --- Configuration ---\n    // 2% House Edge -> EV = 0.98. Payout = Bet * 1.96\n    uint256 public constant PAYOUT_MULTIPLIER = 196; \n    uint256 public constant PAYOUT_DENOMINATOR = 100;\n    \n    // Limits\n    uint256 public constant REVEAL_TIMEOUT_BLOCKS = 250; // Must reveal within ~50 mins (Mainnet)\n    uint256 public constant MIN_BET_DEFAULT = 0.001 ether;\n    uint256 public constant MAX_BET_DEFAULT = 1 ether;\n\n    // --- State ---\n    uint256 public minBet;\n    uint256 public maxBet;\n\n    struct Bet {\n        uint256 amount;\n        uint256 blockNumber;\n        bytes32 commitment;\n        bool exists;\n    }\n\n    struct PlayerStats {\n        uint256 wins;\n        uint256 losses;\n        uint256 totalWagered;\n    }\n\n    mapping(address => Bet) public currentBets;\n    mapping(address => PlayerStats) public playerStats;\n\n    // --- Events ---\n    event BetPlaced(address indexed player, uint256 amount, bytes32 commitment, uint256 blockNumber);\n    event BetRevealed(address indexed player, bool choice, bool outcome, uint256 payout, bytes32 salt);\n    event BetForfeited(address indexed player, uint256 amount);\n    event HouseFundsWithdrawn(address indexed owner, uint256 amount);\n    event LimitsUpdated(uint256 minBet, uint256 maxBet);\n\n    // --- Constructor ---\n    // Strictly empty as per requirements; initializes defaults.\n    constructor() {\n        minBet = MIN_BET_DEFAULT;\n        maxBet = MAX_BET_DEFAULT;\n    }\n\n    // --- Core Game Logic ---\n\n    /**\n     * @notice Place a bet by committing a hash of your choice and salt.\n     * @param commitmentHash keccak256(abi.encodePacked(choice, salt))\n     *                       choice: true (Tails) or false (Heads)\n     *                       salt: random uint256 generated by client\n     */\n    function placeBet(bytes32 commitmentHash) external payable nonReentrant {\n        require(msg.value >= minBet, \"Bet too low\");\n        require(msg.value <= maxBet, \"Bet too high\");\n        require(!currentBets[msg.sender].exists, \"Bet already active\");\n\n        // Solvency Check: Contract must hold enough to pay the potential win.\n        // Balance already includes msg.value.\n        uint256 potentialPayout = (msg.value * PAYOUT_MULTIPLIER) / PAYOUT_DENOMINATOR;\n        require(address(this).balance >= potentialPayout, \"Insufficient house funds\");\n\n        currentBets[msg.sender] = Bet({\n            amount: msg.value,\n            blockNumber: block.number,\n            commitment: commitmentHash,\n            exists: true\n        });\n\n        emit BetPlaced(msg.sender, msg.value, commitmentHash, block.number);\n    }\n\n    /**\n     * @notice Reveal the choice and salt to settle the bet.\n     * @param choice The boolean choice used in commitment (false=Heads, true=Tails)\n     * @param salt The secret salt used in commitment\n     */\n    function reveal(bool choice, uint256 salt) external nonReentrant {\n        Bet memory bet = currentBets[msg.sender];\n        require(bet.exists, \"No active bet\");\n        require(block.number > bet.blockNumber, \"Reveal too early\");\n        require(block.number <= bet.blockNumber + REVEAL_TIMEOUT_BLOCKS, \"Bet expired\");\n\n        // 1. Verify Commitment\n        // Ensures player cannot change their choice after seeing blockhash\n        require(keccak256(abi.encodePacked(choice, salt)) == bet.commitment, \"Invalid commitment\");\n\n        // 2. Generate Randomness\n        // Uses blockhash of the commit block. Since choice was hidden, miner could not bias outcome against it.\n        // blockhash returns 0 if block is older than 256 blocks (handled by timeout check).\n        bytes32 entropy = blockhash(bet.blockNumber);\n        require(entropy != bytes32(0), \"Blockhash unavailable\");\n\n        // Combine entropy with salt and player to ensure uniqueness\n        uint256 random = uint256(keccak256(abi.encodePacked(entropy, salt, msg.sender)));\n        \n        // 3. Determine Result\n        // 0 -> Heads (false), 1 -> Tails (true)\n        bool outcomeIsTails = (random % 2 == 1);\n        bool playerWon = (choice == outcomeIsTails);\n\n        // 4. Update State & Payout\n        playerStats[msg.sender].totalWagered += bet.amount;\n        \n        uint256 payout = 0;\n        if (playerWon) {\n            playerStats[msg.sender].wins++;\n            payout = (bet.amount * PAYOUT_MULTIPLIER) / PAYOUT_DENOMINATOR;\n        } else {\n            playerStats[msg.sender].losses++;\n        }\n\n        // Clean up storage before transfer (Gas refund + Reentrancy protection)\n        delete currentBets[msg.sender];\n\n        emit BetRevealed(msg.sender, choice, outcomeIsTails, payout, bytes32(salt));\n\n        if (payout > 0) {\n            (bool success, ) = payable(msg.sender).call{value: payout}(\"\");\n            require(success, \"Transfer failed\");\n        }\n    }\n\n    /**\n     * @notice Claim funds from expired bets. Prevent stuck ETH if player abandons game.\n     * @param player The address of the player who failed to reveal.\n     */\n    function claimTimeout(address player) external nonReentrant {\n        Bet memory bet = currentBets[player];\n        require(bet.exists, \"No active bet\");\n        require(block.number > bet.blockNumber + REVEAL_TIMEOUT_BLOCKS, \"Not expired yet\");\n\n        uint256 amount = bet.amount;\n        \n        // Stats update: Timeout counts as a loss\n        playerStats[player].losses++;\n        playerStats[player].totalWagered += amount;\n\n        // Clear bet, House retains funds\n        delete currentBets[player];\n\n        emit BetForfeited(player, amount);\n    }\n\n    // --- Admin Functions ---\n\n    function setLimits(uint256 _minBet, uint256 _maxBet) external onlyOwner {\n        require(_minBet <= _maxBet, \"Min > Max\");\n        minBet = _minBet;\n        maxBet = _maxBet;\n        emit LimitsUpdated(_minBet, _maxBet);\n    }\n\n    function withdrawHouseFunds(uint256 amount) external onlyOwner {\n        require(address(this).balance >= amount, \"Insufficient funds\");\n        (bool success, ) = payable(owner()).call{value: amount}(\"\");\n        require(success, \"Transfer failed\");\n        emit HouseFundsWithdrawn(owner(), amount);\n    }\n\n    // --- View Helpers ---\n\n    /**\n     * @notice Helper to generate a valid commitment hash off-chain or for testing.\n     */\n    function generateCommitment(bool choice, uint256 salt) external pure returns (bytes32) {\n        return keccak256(abi.encodePacked(choice, salt));\n    }\n\n    function getBet(address player) external view returns (Bet memory) {\n        return currentBets[player];\n    }\n}\n"
    }
