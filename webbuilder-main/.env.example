# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/webbuilder

# Authentication
SECRET_KEY=your-secret-key-here

# E2B Sandbox (for frontend generation)
E2B_API_KEY=your-e2b-api-key

# LLM API Keys (for AI agents)
OPENAI_API_KEY=your-openai-key
GOOGLE_API_KEY=your-google-key
ANTHROPIC_API_KEY=your-anthropic-key
HUGGINGFACE_API_KEY=your-huggingface-key

# EVI Contract Engine Integration (for smart contracts)
EVI_API_BASE_URL=http://localhost:3001
# For production: https://evi-v4-production.up.railway.app

# BOT Chain Configuration
DEFAULT_NETWORK=botchain-testnet
BOT_CHAIN_RPC_URL=https://rpc.botchain.ai/en
BOT_CHAIN_TESTNET_RPC_URL=https://testnet-rpc.botchain.ai
BOT_CHAIN_CHAIN_ID=88888
BOT_CHAIN_TESTNET_CHAIN_ID=88889
BOT_CHAIN_EXPLORER_URL=https://explorer.botchain.ai
BOT_CHAIN_TESTNET_EXPLORER_URL=https://testnet-explorer.botchain.ai

# Optional: Custom domain configuration
# FRONTEND_BASE_URL=https://evi.buzz  # For Azure deployment
# AZURE_STATIC_IP=XX.XX.XX.XX         # Your Azure static IP
